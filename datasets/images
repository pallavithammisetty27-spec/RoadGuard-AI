# Initialize SQLite Database for History
def init_db():
    conn = sqlite3.connect('potholes_history.db')
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS reports (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            pothole_count INTEGER,
            severity TEXT,
            coordinates TEXT,
            status TEXT
        )
    """)
    conn.commit()
    conn.close()

init_db()

def save_to_db(timestamp, count, severity, coords, status):
    conn = sqlite3.connect('potholes_history.db')
    c = conn.cursor()
    c.execute("INSERT INTO reports (timestamp, pothole_count, severity, coordinates, status) VALUES (?, ?, ?, ?, ?)",
              (timestamp, count, severity, coords, status))
    conn.commit()
    conn.close()

def get_history():
    conn = sqlite3.connect('potholes_history.db')
    df = pd.read_sql_query("SELECT * FROM reports ORDER BY id DESC", conn)
    conn.close()
    return df

